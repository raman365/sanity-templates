# Copy this file to .env.local and fill in your values.

# The GitHub repository whose branches are your templates.
VITE_GITHUB_OWNER=your-github-username
VITE_GITHUB_REPO=your-templates-repo

# Optional: raises the GitHub API rate limit (60 -> 5000 req/h) and allows
# private repos. LOCAL DEVELOPMENT ONLY - a token bundled into a deployed
# site is publicly visible.
# VITE_GITHUB_TOKEN=ghp_xxxxxxxxxxxx
